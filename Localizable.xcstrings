    "AFTR can't see your library, but you can still pick photos to add.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AFTR kan inte se ditt bildbibliotek, men du kan ändå välja bilder att lägga till."
