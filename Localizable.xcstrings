    },
    "AFTR uses this to end a Night automatically when you get home. It never leaves your account.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AFTR använder detta för att avsluta en Night automatiskt när du kommer hem. Det lämnar aldrig ditt konto."
          }
        }
      }
    },
    "AFTR will quietly track the night and build your recap.": {
      "localizations": {
        "sv": {
